# Legacy local Next tree (gitignored); keep out of uploads if present
/apps/

# Not needed for school web build (rootDirectory = musicpro/apps/web)
# Anchor with / so we do NOT ignore nested paths like src/lib/supabase or apps/web/scripts
/store/
/docs/
/scripts/
/assets/
/.cursor/
/.github/
/supabase/
/Codice.js
*.html
/appsscript.json
/.iscrizione-ftp.env
/.clasp.json
/clasp.json

# Mobile / native (Expo) — never part of Vercel web deploy
/musicpro/apps/mobile/

# Local build artifacts that may leak into upload
**/.next/
**/.turbo/
**/dist/
**/.expo/
**/coverage/
**/*.tsbuildinfo

# Large / binary noise
**/*.png
**/*.jpg
**/*.jpeg
**/*.webp
**/*.gif
**/*.mp4
**/*.mov
**/*.pdf
**/screenshots/
