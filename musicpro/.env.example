# =============================================================================
# MusicPro School — variabili ambiente monorepo
# Copia in .env e compila i valori. NON committare .env.
# =============================================================================

# --- Supabase Auth (web — Next.js) ---
# Authentication → URL Configuration → Site URL: https://school.musicproeventi.it
# Redirect URLs: https://school.musicproeventi.it/** + http://localhost:3000/**
# Se Site URL resta localhost, reset password e magic link arrivano su localhost.
# Allinea il progetto cloud: node scripts/sync-school-auth-urls.mjs
NEXT_PUBLIC_SCHOOL_PUBLIC_URL=https://school.musicproeventi.it
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase Auth (mobile — Expo) ---
# Stesso progetto Supabase del web. In Supabase Dashboard aggiungi redirect se usi deep link.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# URL app web (disponibilità sale con calendari esterni — /api/prenotazioni/availability)
EXPO_PUBLIC_WEB_URL=https://school.musicproeventi.it

# --- Supabase (server-side, solo backend / script) ---
# Service role bypassa RLS — usare solo in Edge Functions / script di migrazione, mai nel client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Note autenticazione ---
# - Auth: email + password (sostituisce i magic link GAS).
# - Al primo login/signup, auth.users.email viene collegato a members.email via migration 004_auth_hooks.sql.
# - L'utente deve usare la stessa email presente in anagrafica; altrimenti il login fallisce con messaggio esplicito.
# - Per utenti migrati senza match email: collegare manualmente con UPDATE members SET user_id = '<auth-uuid>' WHERE email = '...';
# - Conferma email: in Supabase Dashboard → Authentication → Providers → Email, abilitare/disabilitare "Confirm email" secondo ambiente.

# --- Resend (email prenotazioni — Edge Function send-booking-email) ---
# RESEND_API_KEY=re_...
# BOOKING_EMAIL_FROM=MusicPro School <noreply@school.musicproeventi.it>
# BOOKING_EMAIL_APP_URL=https://school.musicproeventi.it
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=eur
STRIPE_MODE=test
STRIPE_SECRET_KEY_TEST=sk_test_...
STRIPE_SECRET_KEY_LIVE=sk_live_...
STRIPE_RETURN_URL=https://iscrizione.musicproeventi.it/
# Webhook sale (Stripe Dashboard → endpoint dedicato, mp_flow=room_booking):
# https://<vercel-domain>/api/stripe/webhook
# Eventi: checkout.session.completed, checkout.session.async_payment_succeeded, payment_intent.succeeded

# --- Iscrizione backend (deploy-iscrizione.js) ---
# ISCRIZIONE_BACKEND=gas|supabase
# ISCRIZIONE_SUPABASE_API_URL=https://school.musicproeventi.it/api/iscrizione
# NEXT_PUBLIC_ENROLLMENT_FORM_URL=https://iscrizione.musicproeventi.it/
# Fase 3 BAND: controllata da Admin → Impostazioni → Prenotazioni → "Band obbligatoria".
# Default disattivato: prenotazione singola con quota ok.

# --- Vercel cron (sync calendari esterni) ---
# CRON_SECRET=genera-stringa-casuale-lunga
